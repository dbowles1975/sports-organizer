# Copy to .env. Keep real credentials out of source control.
# Generate a token: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
API_TOKEN=replace-with-a-random-token-at-least-24-characters
TMDB_READ_ACCESS_TOKEN=
PUSHOVER_ENABLED=false
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# webhook is recommended. Alternatives: poll, both.
WATCH_MODE=webhook
# Preview jobs first. Change to false and recreate the container to enable moves.
DRY_RUN=true
STABLE_SECONDS=120
POLL_SECONDS=30

# Paths on your Linux Docker HOST, with the NAS already mounted.
NFL_HOST_PATH=/mnt/nfl
UFC_HOST_PATH=/mnt/ufc
# Keep SQLite on LOCAL Linux storage, not on SMB/NFS.
DATA_HOST_PATH=/home/dave/sports-organizer/data
# Set these to a Linux user/group with write access to the NAS and local data.
PUID=500
PGID=100
API_BIND_ADDRESS=127.0.0.1
API_PORT=8383
TZ=America/New_York

# Published image; use :1.1.4 to pin this release.
SPORTS_ORGANIZER_IMAGE=ghcr.io/dbowles1975/sports-organizer:latest
NFL_INCOMING_DIR=/nfl/DOWNLOAD
NFL_DESTINATION_DIR=/nfl/CHIEFS
UFC_INCOMING_DIR=/ufc/DOWNLOAD
UFC_DESTINATION_DIR=/ufc/COMPLETE
